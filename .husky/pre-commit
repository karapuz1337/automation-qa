#!/usr/bin/env sh
. "$(dirname "$0")/_/h"

# Get staged JavaScript files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|mjs|cjs)$')

if [ -z "$STAGED_FILES" ]; then
  echo "🟡 No JavaScript files staged for commit."
  exit 0
fi

echo "🔍 Running ESLint on staged files..."
echo "$STAGED_FILES" | tr '\n' '\0' | xargs -0 npx eslint --max-warnings 0

# Check if ESLint passed
if [ $? -ne 0 ]; then
  echo "❌ ESLint failed. Please fix the issues before committing."
  echo "💡 Run 'npm run lint:fix' to auto-fix some issues."
  exit 1
fi

echo "✅ ESLint passed on all staged files!"
